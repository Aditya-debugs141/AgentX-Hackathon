# Environment Variables Template for Vercel & Backend Setup

# --- Vercel Backend Environment Variables ---
# Set these in your Vercel Dashboard -> Settings -> Environment Variables

# Choose mode: "proxy" (OpenAI chat completions) or "webhook" (HMAC agent trigger)
HERMES_MODE=proxy

# Public Tunnel URL forwarding to your local Docker container
# Proxy example: https://xxxx.ngrok-free.app/v1/chat/completions
# Webhook example: https://xxxx.ngrok-free.app/webhook/my-endpoint
HERMES_ENDPOINT_URL=

# Only required if HERMES_MODE=webhook (HMAC secret generated during 'hermes webhook subscribe')
HERMES_HMAC_SECRET=

# Optional: Protect Vercel endpoint against public unauthorized traffic
FRONTEND_API_KEY=

# --- Frontend Environment Variables ---
# Optional if deployed as single Vercel app (leave empty to use relative /chat API routes)
VITE_API_BASE_URL=
