HERMES_ENDPOINT=https://your-cloudflare-url.trycloudflare.com/v1/chat/completions
HERMES_API_KEY=your-hermes-api-key
HERMES_MODEL=openai/gpt-oss-20b

# Server-only secret used to sign short-lived browser session tokens.
AUTH_SIGNING_SECRET=replace-with-a-long-random-server-secret

# Vite exposes only VITE_* variables to browser code. Leave this empty when
# the frontend and backend are served from the same Vercel deployment.
VITE_API_BASE_URL=
